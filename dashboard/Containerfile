# Dashboard: built with Vite, served by nginx, which also forwards /api (and the WebSocket) to the API
# service, so the browser talks to one origin.
FROM docker.io/library/node:22.11.0-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY index.html vite.config.js ./
COPY src ./src
RUN npx vite build

FROM docker.io/library/nginx:1.27.2-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
