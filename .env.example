# Development-only settings. Copy to .env (make env) and change if you like; .env is not committed.
POSTGRES_PORT=5433
POSTGRES_SUPERUSER_PASSWORD=dev-postgres-pw
COLDCHAIN_DB_PASSWORD=dev-coldchain-pw
COLDCHAIN_APP_PASSWORD=dev-app-pw
KEYCLOAK_DB_PASSWORD=dev-keycloak-pw
KEYCLOAK_ADMIN_PASSWORD=dev-keycloak-admin-pw
KEYCLOAK_PORT=8080
MQTT_PORT=1883
KAFKA_PORT=9092
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
API_PORT=8000
NOTIFY_PORT=8001
SMS_GATEWAY_PORT=8002
# SMS gateway used by the notification service: the local emulator by default. For the Africa's Talking
# sandbox, set SMS_GATEWAY_URL=https://api.sandbox.africastalking.com and AT_API_KEY to the sandbox key
# (see README).
SMS_GATEWAY_URL=http://sms-gateway:8000
AT_USERNAME=sandbox
AT_API_KEY=dev-at-key
# development only: send every SMS to one phone (e.g. the sandbox simulator); replies still act as that number's user
# shortcode or registered sender id the SMS come from (optional)
AT_SENDER_ID=
SMS_REDIRECT_TO=
# development only: count a message the gateway accepts as delivered (the sandbox's delivery reports are unreliable)
SMS_TRUST_SENT=false
SMS_CALLBACK_TOKEN=dev-callback-token
CODE_SECRET=dev-code-secret
